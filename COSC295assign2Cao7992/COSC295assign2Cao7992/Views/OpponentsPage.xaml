<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="COSC295assign2Cao7992.Views.OpponentsPage">
    <StackLayout>
        <Button Text="Add New Opponent" Clicked="AddOpponentClicked"/>
        <ListView x:Name="OpponentsListView" ItemTapped="OnOpponentSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextCell Text="{Binding FirstName}" Detail="{Binding LastName}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>
</ContentPage>